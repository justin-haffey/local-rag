@page "/manage"
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ Layout = null; var csrf = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken; }
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="csrf-token" content="@csrf"><title>Local RAG Manager</title><link rel="stylesheet" href="/manager.css"><script src="/manager-links.js" defer></script><script src="/manager.js" defer></script></head>
<body><header><h1>Local RAG</h1><p>Manage knowledge bases on this computer.</p><nav aria-label="Sections"><a href="#catalog">Knowledge bases</a><a href="#search">Search</a><a href="#project">Project file</a><a href="#system">System</a><a href="#maintenance">Maintenance</a></nav></header>
<main><p id="notice" role="status" aria-live="polite">Connecting…</p><p id="freshness"></p>
<section id="session"><h2>Local session</h2><form id="login"><label>Local access token <input name="token" type="password" autocomplete="off" required></label><label>Management token (for remove/reset) <input name="managementToken" type="password" autocomplete="off"></label><button>Sign in for 30 minutes</button></form><button id="logout" type="button">Sign out</button><p>Tokens are used only to establish this session. Launch the installed manager shortcut to sign in automatically.</p></section>
<section id="catalog"><h2>Knowledge bases</h2><label>Filter knowledge bases <input id="filter" type="search"></label><button id="refresh" type="button">Refresh</button><div class="table"><table><thead><tr><th>Select</th><th>Name / description</th><th>Scope</th><th>State</th><th>Latest success</th><th>Actions</th></tr></thead><tbody id="sources"></tbody></table></div>
<details><summary>Add folder</summary><form id="add"><label>Source folder (absolute host path) <input name="rootPath" id="sourceRoot" required placeholder="C:\References"></label><button type="button" id="browse">Browse host folders</button><label>Name <input name="name" maxlength="120" required></label><label>Description <textarea name="description" maxlength="2000"></textarea></label><label>Scope <select name="scope"><option value="local">Local — associated with a project</option><option value="global">Global — reusable</option></select></label><label>Owning project folder (required for local scope) <input name="owningProjectRoot"></label><button>Add and index</button></form></details></section>
<dialog id="picker"><h2>Choose a host folder</h2><p>Direct children only. Paste a path for network roots. Root shortcuts list currently ready drives.</p><label>Absolute folder <input id="pickerPath"></label><button id="pickerGo" type="button">Open folder</button><button id="pickerParent" type="button">Parent</button><div id="drives"></div><ul id="directories"></ul><p id="pickerError" role="status"></p><button id="pickerSelect" type="button">Use current folder</button><button id="pickerClose" type="button">Cancel</button></dialog>
<dialog id="copyFallback"><h2>Copy text</h2><p>Clipboard permission is unavailable. The text is selected; press Ctrl+C or use your browser’s Copy action.</p><label>Copyable text <textarea id="copyFallbackText" rows="10" readonly></textarea></label><button type="button" id="copyFallbackClose">Close</button></dialog>
<dialog id="details"><h2>Knowledge base details</h2><pre id="detailState"></pre><form id="metadata"><input type="hidden" name="sourceId"><input type="hidden" name="expectedRevision"><label>Name <input name="name" maxlength="120" required></label><label>Description <textarea name="description" maxlength="2000"></textarea></label><label>Scope <select name="scope"><option value="">Choose scope explicitly</option><option value="global">Global</option><option value="local">Local</option></select></label><label>Owning project folder <input name="owningProjectRoot"></label><button>Save metadata</button><button type="button" id="detailsClose">Cancel</button></form></dialog>
<section id="search"><h2>Search and preview</h2><form id="searchForm"><label>Search scope <select name="scope"><option value="selected">Selected knowledge bases above</option><option value="project">Explicit project file below</option><option value="all">All catalog (management search)</option></select></label><label>Query <input name="query" required></label><label>Mode <select name="mode"><option value="Hybrid">Hybrid</option><option value="Lexical">Lexical</option><option value="Vector">Vector</option></select></label><label>Language <input name="language" maxlength="64"></label><label>Relative path prefix <input name="pathPrefix" maxlength="512"></label><label>Limit <input name="limit" type="number" min="1" max="50" value="12"></label><label>Vector weight <input name="alpha" type="number" min="0" max="1" step="0.05" value="0.65"></label><button>Search</button></form><div id="results"></div></section>
<section id="project"><h2>Explicit project configuration</h2><p>The source folder and destination project are independent. Choose exactly where to save <code>.localrag.json</code>. Read it before editing an existing file.</p><label>Destination project folder <input id="projectRoot"></label><button id="readConfig" type="button">Read chosen project</button><button id="newConfig" type="button">Use selected knowledge bases</button><label>Configuration JSON <textarea id="config" rows="12" spellcheck="false"></textarea></label><button id="validateConfig" type="button">Validate</button><button id="saveConfig" type="button">Save to chosen project</button><button id="copyConfig" type="button">Copy</button><button id="downloadConfig" type="button">Download</button></section>
<section id="system"><h2>System</h2><pre id="systemState">Awaiting session…</pre></section>
<section id="maintenance"><h2>Maintenance</h2><p>Reset removes all indexes and Local RAG metadata from this installation's selected provider. Original files remain on disk. A management session and two confirmation steps are required.</p><button id="reset" type="button">Prepare reset…</button><p>To stop the host, use Windows Task Manager to end LocalRag.Host. The installed shortcut starts it again. Closing VS Code leaves it running.</p></section></main></body></html>
